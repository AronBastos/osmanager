# Arquivo de configuração de variáveis de ambiente para Docker
# Copie este arquivo para .env.local e edite conforme necessário

# ==========================================
# MySQL Configuration
# ==========================================
MYSQL_ROOT_PASSWORD=root_password
MYSQL_DATABASE=osmanager
MYSQL_USER=osmuser
MYSQL_PASSWORD=osmuser_password
MYSQL_PORT=3306

# ==========================================
# Tomcat Configuration
# ==========================================
TOMCAT_PORT=8080

# ==========================================
# Application Configuration
# ==========================================
APP_ENV=production
BUILD_ENV=production
TZ=America/Sao_Paulo

# ==========================================
# Java Configuration
# ==========================================
# Formato: -Xmx[memoria]m -Xms[memoria]m [outras opcoes]
JAVA_OPTS=-Xmx512m -Xms256m -XX:+UseG1GC

# ==========================================
# phpMyAdmin Configuration
# ==========================================
PHPMYADMIN_PORT=8081

# ==========================================
# Development Mode (descomente para desenvolvimento)
# ==========================================
# APP_ENV=development
# JAVA_OPTS=-Xmx1024m -Xms512m -XX:+UseG1GC -agentlib:jdwp=transport=dt_socket,server=y,suspend=n,address=5005

