<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <!--
    ============================================================
    SPRING BOOT PARENT — INTERVIEW NOTE
    ============================================================
    spring-boot-starter-parent provides:
      - Dependency management (no need to specify versions for common libs)
      - Plugin management (maven-compiler, surefire, etc.)
      - Default encoding UTF-8 and Java version defaults

    Q: "What does spring-boot-starter-parent do?"
    A: It's a Maven BOM (Bill of Materials) POM that centralises
       dependency and plugin management. When a library is in the BOM,
       Spring Boot guarantees all transitive dependencies are compatible.
    ============================================================
    -->
    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>3.2.3</version>
        <relativePath/>
    </parent>

    <groupId>com.osmanager</groupId>
    <artifactId>osmanager</artifactId>
    <version>1.0-SNAPSHOT</version>

    <!--
    PACKAGING: JAR (not WAR)
    Spring Boot embeds Tomcat — no external application server needed.
    The fat JAR contains everything: your code + Tomcat + all dependencies.
    Run with: java -jar osmanager-1.0-SNAPSHOT.jar
    -->
    <packaging>jar</packaging>

    <name>OSManager — Service Order Management System</name>
    <description>
        Spring Boot study project — covers IoC, DI, REST, JPA, Transactions,
        Exception Handling, and Testing as per the Java + Spring Boot study guide.
    </description>

    <properties>
        <java.version>17</java.version>
    </properties>

    <dependencies>

        <!-- ============================================================
             SPRING BOOT STARTERS — INTERVIEW NOTE
             ============================================================
             Each starter is a convenience dependency that pulls in
             everything needed for a feature.

             spring-boot-starter-web pulls in:
               - Spring MVC (DispatcherServlet, @RestController, etc.)
               - Jackson (JSON serialization/deserialization)
               - Embedded Tomcat (no WAR deployment needed)

             Q: "How does Spring Boot auto-configuration work?"
             A: On startup, Spring Boot scans the classpath. For each
                library it detects, it checks
                META-INF/spring/...AutoConfiguration.imports for
                @ConditionalOnClass / @ConditionalOnMissingBean classes.
                These create beans automatically ONLY when conditions are met.
                You override any auto-configured bean by declaring your own
                @Bean of the same type.
             ============================================================ -->

        <!-- Web: Spring MVC + embedded Tomcat + Jackson -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-web</artifactId>
        </dependency>

        <!-- Data JPA: Spring Data + Hibernate + HikariCP connection pool -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-data-jpa</artifactId>
        </dependency>

        <!--
        Bean Validation: adds @NotBlank, @Email, @Size, @Min, @Max, etc.
        Used with @Valid on @RequestBody to auto-validate incoming JSON.
        When validation fails → MethodArgumentNotValidException →
        caught by @ControllerAdvice → returns structured 400 response.
        -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-validation</artifactId>
        </dependency>

        <!-- MySQL driver — runtime scope: needed to run, not to compile -->
        <dependency>
            <groupId>com.mysql</groupId>
            <artifactId>mysql-connector-j</artifactId>
            <scope>runtime</scope>
        </dependency>

        <!-- H2 in-memory database — test scope only, used by @DataJpaTest -->
        <dependency>
            <groupId>com.h2database</groupId>
            <artifactId>h2</artifactId>
            <scope>test</scope>
        </dependency>

        <!--
        Spring Boot Test starter includes:
          - JUnit 5 (Jupiter)
          - Mockito
          - AssertJ
          - MockMvc for HTTP layer testing
          - @SpringBootTest, @WebMvcTest, @DataJpaTest annotations
        -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>

        <!-- Springdoc: auto-generates OpenAPI 3 docs + Swagger UI at /swagger-ui.html -->
        <dependency>
            <groupId>org.springdoc</groupId>
            <artifactId>springdoc-openapi-starter-webmvc-ui</artifactId>
            <version>2.3.0</version>
        </dependency>

    </dependencies>

    <build>
        <plugins>
            <!--
            Spring Boot Maven Plugin:
              mvn spring-boot:run  — runs the embedded Tomcat app
              mvn package          — creates the fat JAR with all deps

            The repackage goal embeds Tomcat + all deps into a single JAR.
            This is the "opinionated" approach Spring Boot is famous for.
            -->
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
            </plugin>
        </plugins>
    </build>

</project>
